# --- file: .gitignore ---
# Secrets / local config
.env
.env.*
!.env.example
.envrc

# Local sync site config (LAN paths / IPs) — helpers/ scripts may be committed
helpers/p1-sync.config.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/

# SQLite + runtime data (never publish meter history)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
meter_history.db*

# Import / archive working dirs (app runtime only; keep docs/todo/_archive in git)
import_queue/
/_archive/
*.zip
*.7z
*.rar
*.xml

# Logs
*.log
*.log.old
docs/logs/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# Sync / deploy noise
*.bat~
*.ps1~
*.me
