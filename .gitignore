# --- file: .gitignore ---
# Compiled from .gitignore.common (sections 1-2) + section 3 below.
# Edit .gitignore.common for shared patterns; keep repo-only noise in section 3.

# === 1. General ===
# Secrets / env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Node
node_modules/

# Logs / caches
*.log
.cache/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/

# Windows / Cursor / sync junk
*.lnk
_tmp*
*.bak


# === 2. Operator common (all Wannes repos) ===

# Local sync site configs (never commit LAN paths/creds)
helpers/*-sync.config
helpers/*-sync.config.json

# Ops log staging (PC pull into git tree)
/docs/logs
docs/logs/

# Runtime DBs (tighten in section 3 if a repo tracks a seed DB)
*.sqlite*
*.db
*.db-wal
*.db-shm

# === 3. homepower_dashboard ===

# Extra env / packaging
.envrc
*.egg-info/

# Meter history naming (also covered by *.db)
meter_history.db*

# Import / working dirs (runtime only)
import_queue/
*.zip
*.7z
*.rar
*.xml
*.log.old

# Sync / deploy editor junk
*.bat~
*.ps1~
*.me
.vscode/

# Keep docs/todo/_archive/ in git; ignore other _archive dirs
_archive/
!docs/todo/_archive/
!docs/todo/_archive/**
