# --- file: .env.example ---
# Copy to .env on the host from encrypted storage. Never commit .env. Never sync .env via p1-sync.

# ==============================================================
# P1 digital meter (mandatory)
# ==============================================================
P1_IP=0.0.0.0

# ==============================================================
# SMA WebConnect inverter (optional)
# ==============================================================
SMA_IP=0.0.0.0
SMA_USER=user
SMA_PASSWORD=changeme

# ==============================================================
# Sunny WebBox gateway (optional)
# ==============================================================
SUNNYWEBBOX_IP=0.0.0.0
SUNNYWEBBOX_PASSWORD=changeme

# ==============================================================
# UI presentation (optional; code has generic defaults)
# ==============================================================
SITE_TITLE=Energy Dashboard
SITE_TAGLINE=Home Energy Hub
SITE_PAGE_TITLE=Energy Dashboard
