# --- file: .env.example ---
# Copy to .env on the host from encrypted storage. Never commit .env. Never sync .env via p1-sync.
# After setup, this file holds the backup encryption key only.
# Devices, titles, and plant limits are edited on the Settings page and stored in meter_history.db.
# If this file still contains the legacy keys below, they are imported once when app_settings is empty.
# The import does not remove them from this file and does not copy DB_BACKUP_ENCRYPTION_KEY.

# ==============================================================
# Database backup encryption
# Stays in this file; not on the Settings page
# ==============================================================
DB_BACKUP_ENCRYPTION_KEY=


# ==============================================================
# ==============================================================
# Legacy keys (imported once; not read after app_settings has rows)
# ==============================================================

# ==============================================================
# P1 digital meter
# ==============================================================
P1_IP=0.0.0.0

# ==============================================================
# SMA WebConnect inverter (optional)
# ==============================================================
SMA_IP=0.0.0.0
SMA_USER=user
SMA_PASSWORD=changeme

# ==============================================================
# Sunny WebBox gateway (optional)
# ==============================================================
SUNNYWEBBOX_IP=0.0.0.0
SUNNYWEBBOX_PASSWORD=changeme

# ==============================================================
# Water-Link portal (optional)
# ==============================================================
WATERLINK_USER=user
WATERLINK_PASSWORD=changeme

# ==============================================================
# Sunny Portal (optional)
# ==============================================================
# SUNNYPORTAL_USER=
# SUNNYPORTAL_PASSWORD=
# SUNNYPORTAL_PLANT_ID=
# SUNNYPORTAL_TIMEZONE=Europe/Paris

# ==============================================================
# UI presentation (optional; code has generic defaults)
# ==============================================================
SITE_TITLE=Energy Dashboard
SITE_TAGLINE=Home Energy Hub
SITE_PAGE_TITLE=Energy Dashboard